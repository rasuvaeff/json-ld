{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "php://stderr",
        "summary": "build/infection-summary.log"
    },
    "testFramework": "testo",
    // Run with --with-uncovered: the MSI is measured over all of src/, not only
    // over lines a test names in #[Covers]. Survivors are of three kinds, no ignores:
    // - ~16 mutants of constructor signature defaults (FalseValue/TrueValue) stay
    //   "Not Covered": pcov records no executable line for a signature, so no test
    //   can be credited with them.
    // - genuine equivalents: Rdf/JsonCanonicalizer (null branch, DEL str_replace that
    //   json_encode never needs, case-redundant sign and exponent arithmetic, (int)
    //   cast), ContextProcessor ('?? false' on an unset key, duplicate-container check
    //   subsumed by the final key whitelist, (float) cast on an int-or-float version),
    //   ExpansionRun EMPTY marker value (only array_key_exists is read).
    // - remaining non-equivalent survivors in Rdf/CanonicalizationRun, NodeMap, ToRdf,
    //   FromRdf and ExpansionRun that the suite does not pin yet.
    "minMsi": 92,
    "mutators": {
        "@default": true,
        // Off: with --with-uncovered a PublicVisibility mutant sits on a parameterless
        // method's signature line, which has no executable opcode under pcov/xdebug,
        // so it is reported Not Covered and can never be killed, whatever #[Covers]
        // says. Measured on pinned-http-client 2026-11-01: 4 of 4 such mutants were
        // Not Covered, none killed; here it is 74 of the ~90 signature mutants.
        "PublicVisibility": false
    }
}
